##############################################################################
#  Daghoip Ikassa — variables d'environnement
#
#  Copiez ce fichier vers `.env.local` (développement) ou renseignez ces
#  variables dans votre plateforme d'hébergement (production).
#
#  ⚠️ Ne committez JAMAIS de fichier `.env.local` ou `.env.production`.
##############################################################################

# --- Supabase (obligatoire) -------------------------------------------------
# Tableau de bord Supabase → Project Settings → API

# URL du projet, ex. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé « anon / public ». Exposée au navigateur : c'est normal et sans risque,
# toute l'autorisation étant assurée par les politiques RLS PostgreSQL.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé « service_role ». SECRÈTE — contourne toutes les politiques RLS.
# Réservée aux tâches d'administration côté serveur (modération, maintenance).
# Ne jamais la préfixer par NEXT_PUBLIC_ et ne jamais l'exposer au client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Fournisseurs d'authentification externes (facultatif) -------------------
# Renseignez-les côté Supabase (Authentication → Providers) ou via
# `supabase config push`. Sans ces valeurs, les boutons Google/Facebook
# affichent une erreur explicite et la connexion par e-mail reste disponible.
#
# Google Cloud Console → Identifiants → ID client OAuth
# URL de redirection autorisée : https://<ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# Meta for Developers → Facebook Login
SUPABASE_AUTH_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_FACEBOOK_SECRET=

# --- Connexion par SMS (facultatif) ------------------------------------------
# REQUIS pour la connexion par téléphone. Twilio couvre le Gabon (+241).
# Sans ces valeurs, l'envoi d'OTP échoue et l'interface bascule proprement
# sur la connexion par e-mail.
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# --- Site -------------------------------------------------------------------
# URL publique canonique, sans slash final. Sert aux métadonnées SEO, au
# sitemap et aux redirections d'authentification par e-mail.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Carte de repérage (facultatif) -----------------------------------------
# Fournisseur de tuiles affichées sur la page d'une annonce. Par défaut
# OpenStreetMap, dont la politique d'usage tolère un trafic modéré et impose
# l'attribution ci-dessous. Au-delà, passez à un fournisseur payant.
#
# ⚠️ L'hôte est repris automatiquement dans la CSP (`next.config.ts`) : changer
# cette URL suffit, il n'y a pas d'autre réglage à toucher. Le gabarit doit être
# en HTTPS et contenir {z}, {x} et {y}.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Mention légale affichée en bas de la carte. À adapter au fournisseur choisi.
NEXT_PUBLIC_MAP_ATTRIBUTION=© contributeurs OpenStreetMap

# --- Mobile Money (facultatif) ------------------------------------------------
# Encaissement des abonnements et des mises en avant. Tant qu'un opérateur n'est
# pas entièrement renseigné, il n'apparaît PAS dans la liste des moyens de
# paiement : le règlement se fait alors par virement ou en espèces, avec
# confirmation manuelle depuis /admin/paiements.
#
# ⚠️ Ces adaptateurs sont complets dans leur forme mais n'ont pas été éprouvés
# contre les API réelles (voir lib/payments/providers/mobile-money.ts). Avant
# toute mise en service, confrontez chemins, noms de champs et schéma de
# signature à la documentation contractuelle de l'opérateur, puis rejouez un
# encaissement complet en bac à sable.
#
# URL de rappel à déclarer chez l'opérateur :
#   https://votre-domaine.ga/api/paiements/airtel_money/callback
#   https://votre-domaine.ga/api/paiements/moov_money/callback

AIRTEL_MONEY_BASE_URL=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
# Secret partagé servant à signer les rappels (HMAC-SHA256, 16 caractères mini).
AIRTEL_MONEY_CALLBACK_SECRET=

MOOV_MONEY_BASE_URL=
MOOV_MONEY_CLIENT_ID=
MOOV_MONEY_CLIENT_SECRET=
MOOV_MONEY_CALLBACK_SECRET=

# --- Assistant de rédaction (facultatif) --------------------------------------
# Alimente deux boutons du formulaire de dépôt : « Rédiger pour moi » et
# « Corriger les fautes ». Sans clé, ces boutons ne sont pas affichés et le
# dépôt d'annonce reste entièrement utilisable — la mise en forme
# typographique, elle, est purement locale et fonctionne toujours.
#
# Les autres fonctions dites « intelligentes » (suggestion de prix, détection
# de doublons, signaux de fraude, recommandations) sont calculées en base et ne
# dépendent d'aucune clé.
ANTHROPIC_API_KEY=
# Surcharge du modèle. Par défaut claude-haiku-4-5-20251001, suffisant ici.
AI_MODEL=

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=3000

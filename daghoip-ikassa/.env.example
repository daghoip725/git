##############################################################################
#  Daghoip Ikassa — variables d'environnement
#
#  Copiez ce fichier vers `.env.local` (développement) ou renseignez ces
#  variables dans votre plateforme d'hébergement (production).
#
#  ⚠️ Ne committez JAMAIS de fichier `.env.local` ou `.env.production`.
##############################################################################

# --- Supabase (obligatoire) -------------------------------------------------
# Tableau de bord Supabase → Project Settings → API

# URL du projet, ex. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé « anon / public ». Exposée au navigateur : c'est normal et sans risque,
# toute l'autorisation étant assurée par les politiques RLS PostgreSQL.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé « service_role ». SECRÈTE — contourne toutes les politiques RLS.
# Réservée aux tâches d'administration côté serveur (modération, maintenance).
# Ne jamais la préfixer par NEXT_PUBLIC_ et ne jamais l'exposer au client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Fournisseurs d'authentification externes (facultatif) -------------------
# Renseignez-les côté Supabase (Authentication → Providers) ou via
# `supabase config push`. Sans ces valeurs, les boutons Google/Facebook
# affichent une erreur explicite et la connexion par e-mail reste disponible.
#
# Google Cloud Console → Identifiants → ID client OAuth
# URL de redirection autorisée : https://<ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# Meta for Developers → Facebook Login
SUPABASE_AUTH_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_FACEBOOK_SECRET=

# --- Connexion par SMS (facultatif) ------------------------------------------
# REQUIS pour la connexion par téléphone. Twilio couvre le Gabon (+241).
# Sans ces valeurs, l'envoi d'OTP échoue et l'interface bascule proprement
# sur la connexion par e-mail.
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# --- Site -------------------------------------------------------------------
# URL publique canonique, sans slash final. Sert aux métadonnées SEO, au
# sitemap et aux redirections d'authentification par e-mail.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
